# Copy to .env (which git ignores) and fill in.

# From Cloudflare: Zero Trust > Networks > Tunnels > your tunnel > the token
# in the install command (the long string after --token).
TUNNEL_TOKEN=

# The secret part of your link: https://cards.example.com/?key=<SHARE_KEY>
# At least 8 characters: letters, digits, - and _. Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(12))"
SHARE_KEY=

# Your tunnel's address. Only used to print the full link in the logs.
PUBLIC_URL=https://cards.example.com

# Only needed if your user on the server isn't UID/GID 1000 (check with: id)
# APP_UID=1000
# APP_GID=1000
